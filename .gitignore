# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
graphify-out

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Backups & Restores
/tmp-backups/
/tmp-restores/
*.zip
public/*.zip
public/backup-*.zip

# Public uploaded images (keeps system SVGs)
public/*.png
public/*.jpg
public/*.jpeg
public/*.webp
!public/next.svg
!public/vercel.svg
!public/file.svg
!public/globe.svg
!public/window.svg
# typescript & system artifacts
*.tsbuildinfo
next-env.d.ts
design-system
.agents


